# https://www.sanity.io/manage — projet puis copier l’ID
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Organisation Sanity (sanity deploy / CLI) — ex. oqFti06vu
SANITY_ORGANIZATION_ID=

# Optionnel : token lecture seule (API) pour Next ; ne pas versionner. Régénérer si exposé.
SANITY_API_READ_TOKEN=

# Optionnel : formulaire https://formspree.io (créer un formulaire, copier l’URL /f/xxxx)
NEXT_PUBLIC_FORMSPREE_ACTION=

# URL canonique pour SEO / sitemap (sinon valeur par défaut ausaintsperes.com)
# NEXT_PUBLIC_SITE_URL=https://www.ausaintsperes.com

# Image plein écran d’accueil (optionnel, chemin public). Défaut : /assets/hero-cover.jpg
# NEXT_PUBLIC_HERO_IMAGE=/assets/hero-cover.jpg
